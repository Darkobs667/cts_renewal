APP_NAME="CTS App"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=

DB_CONNECTION=sqlite
DATABASE_URL=

# PostgreSQL (Render / Supabase) — utiliser le Session Pooler port 5432.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# URL du frontend Vercel (sans slash final ni retour à la ligne).
FRONTEND_URL=

JWT_SECRET=

# Clé HMAC dédiée à l'anonymisation des votes (indépendante de APP_KEY).
# Générer avec : php -r "echo bin2hex(random_bytes(32));"
# Ne JAMAIS utiliser la même valeur que APP_KEY ou JWT_SECRET.
VOTE_HASH_KEY=

# ─── Photos de candidats ──────────────────────────────────────────────────────
# Production : Cloudinary obligatoire (seule l'URL est stockée en BDD).
CANDIDATE_PHOTO_STORAGE=cloudinary
# Format : cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=cts/candidates

# ─── Cache & rate-limiting ────────────────────────────────────────────────────
# Utiliser la table `cache` pour partager le cache entre instances.
CACHE_STORE=database
CACHE_LIMITER=database

# ─── Compte admin — LOCAL uniquement ─────────────────────────────────────────
# Lues par AdminSeeder quand APP_ENV=local (php artisan db:seed).
# Ne mettez JAMAIS de valeurs réelles ici ; renseignez votre .env local.
ADMIN_LOCAL_EMAIL=
ADMIN_LOCAL_PASSWORD=

# ─── Compte admin — PRODUCTION uniquement ────────────────────────────────────
# À définir dans le dashboard Render AVANT le premier déploiement.
# Lues par AdminSeeder quand APP_ENV=production.
# Supprimez-les du dashboard après la première migration si vous préférez.
CTS_ADMIN_EMAIL=
CTS_ADMIN_PASSWORD=
